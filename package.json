{
  "name": "@zcode/wallpaper-engine",
  "version": "0.1.0",
  "description": "Wallpaper Engine backgrounds for the ZCode workbench (web + desktop): discover your local Wallpaper Engine install, render Video/Web wallpapers behind the chat, Scene wallpapers as pure-JS rendered frames, with iOS-style liquid glass, adjustable scrim/blur/filters, carousel rotation and custom uploads. Ported from dsh-plugin-wallpaper-engine.",
  "type": "module",
  "main": "lib/host.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "zcode-wallpaper-engine": "bin/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/host.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./host": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/host.js"
    },
    "./scene-renderer": {
      "default": "./lib/scene-renderer.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "lib/host.js",
    "lib/client.js",
    "lib/pkg-extract.js",
    "lib/scene-renderer.js",
    "lib/scene-render-worker.mjs",
    "lib/scene-manifest.js",
    "lib/scene-player.js",
    "lib/scene-scripts.js",
    "lib/scene-script-apis.js",
    "lib/apng-encode.js",
    "lib/font-render.js",
    "lib/we-renderer/",
    "lib/types/",
    "zcode.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "verify:mount": "node scripts/verify-mount.mjs",
    "verify": "node scripts/auto-review.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint lib/host.js src/client scripts bin 2>/dev/null || true",
    "prepare": "node scripts/build-client.mjs"
  },
  "keywords": [
    "zcode",
    "wallpaper",
    "wallpaper-engine",
    "theme",
    "background",
    "liquid-glass"
  ],
  "publishConfig": {
    "access": "public"
  },
  "zcode": {
    "integrations": {
      "server": "Mount `createWallpaperEngineApp()` on the ZCode Hono server (see zcode.patch.yml + scripts/install-to-zcode.mjs).",
      "web": "Inject lib/client.js into packages/web/index.html (the install script does this).",
      "desktop": "The Electron renderer loads the same web build; the same injection covers it."
    }
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "jpeg-js": "^0.4.4",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "@shaderfrog/glsl-parser": "^7.0.1"
  },
  "peerDependencies": {
    "hono": "^4.12.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.28.2",
    "hono": "^4.12.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
